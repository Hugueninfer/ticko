# Keep the build context small and free of local state and secrets.
.git
.env
.env.*
**/node_modules
apps/api/vendor
apps/api/build
apps/api/.scribe
apps/api/.phpunit.cache
apps/api/storage/logs/*
apps/api/storage/framework/cache/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/storage/app/private/*
apps/api/bootstrap/cache/*.php
apps/web/dist
apps/web/coverage
apps/web/test-results
apps/web/playwright-report
apps/mobile/*
!apps/mobile/package.json
services
packages/*/coverage
packages/api-client/src/schema.d.ts
