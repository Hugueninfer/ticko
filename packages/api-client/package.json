{
  "name": "@ticko/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Ticko API, generated from apps/api/resources/openapi/openapi.json",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/resources/openapi/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
