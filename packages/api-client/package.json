{
  "name": "@ticko/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Ticko API, generated from apps/api/resources/openapi/openapi.json",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/resources/openapi/openapi.json -o src/schema.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
