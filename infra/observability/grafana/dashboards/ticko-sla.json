        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tenant) (ticko_tickets_overdue{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}}",
          "range": false,
          "instant": true,
          "refId": "A",
