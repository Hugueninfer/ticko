      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (tenant, deadline) (ticko_tickets_overdue{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} · {{deadline}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
