# Ticko local environment. `make env` copies this file to .env and fills in
# every value marked "generated" with random secrets. Never commit .env.

APP_NAME=Ticko
APP_ENV=local
# Generated
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Postgres. The app connects with a non-superuser role without BYPASSRLS.
DB_DATABASE=ticko
DB_USERNAME=ticko_app
# Generated
DB_PASSWORD=
POSTGRES_SUPERUSER=postgres
# Generated (only used to initialise the database)
POSTGRES_SUPERUSER_PASSWORD=

REDIS_CLIENT=phpredis
# Generated
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true behind HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Origins that get cookie (session) authentication. Docker serves the web app
# on the API's own origin (:8080); `pnpm dev` serves it on :5173 and proxies
# /api and /sanctum to :8080, so the browser still makes same-origin requests
# only. There is no CORS configuration with credentials.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173
SANCTUM_TOKEN_PREFIX=ticko_

HASH_DRIVER=argon2id

# Realtime (Laravel Reverb). Clients get the key from GET /api/v1/realtime and
# connect through the web server at /app; the secret never leaves the server.
REVERB_APP_ID=ticko
# Generated
REVERB_APP_KEY=
# Generated
REVERB_APP_SECRET=
# Comma-separated hosts allowed to open browser WebSockets ("*" = any).
REVERB_ALLOWED_ORIGINS=*

# Expo push notifications. Optional access token (EAS "enhanced push security").
EXPO_ACCESS_TOKEN=

# Ticko settings (see apps/api/config/ticko.php)
TICKO_DOCS_ENABLED=true
# One-click demo sign-in on the login page (after `make demo`). Never works in production.
TICKO_DEMO_LOGIN=true
TICKO_HORIZON_ADMINS=

# Host binding for the web server (keep 127.0.0.1 in development). Set it to
# 0.0.0.0 only while testing the mobile app on a phone on your Wi-Fi (see
# apps/mobile/README.md): it exposes this port, and only this port, to the LAN.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# AI: knowledge-base search and reply suggestions (an agent always approves
# before anything reaches a customer). "fake" works offline, with no key.
#   text:       fake | gemini | groq | ollama
#   embeddings: fake | gemini | ollama  (768 dimensions; changing it needs
#               `php artisan ticko:kb:reindex`)
# Keys go ONLY in your local .env, never in this file or the repository.
# Note: on Gemini's free tier Google may use the data sent to improve its
# products; use a paid key or Ollama for real customer data.
TICKO_AI_TEXT_PROVIDER=fake
TICKO_AI_EMBEDDING_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
# Free tier: ~20 requests/day per model. `make demo` waits this long between AI calls.
TICKO_DEMO_AI_PAUSE=6
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ticket classifier (services/classifier). Started by `make up-ml`, which also
# points the API at it; to keep it on with `make up`, add to this file:
#   COMPOSE_PROFILES=ml
#   CLASSIFIER_URL=http://classifier:8000
# The token is generated by `make env`; the queue sends it on every request.
CLASSIFIER_TOKEN=
CLASSIFIER_MODEL=lora
CLASSIFIER_MIN_CONFIDENCE=0.6

# Observability (`make up-obs`): OpenTelemetry Collector, Prometheus, Tempo,
# Loki and Grafana on http://localhost:3001 (127.0.0.1 only, login required).
# The admin password is generated by `make env`; there is no default.
# Telemetry is redacted (no passwords, tokens, cookies, keys, ticket text or
# personal data). To keep it on with `make up`, also add COMPOSE_PROFILES=obs.
TICKO_TELEMETRY=false
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=

# Encrypted backups (`make backup`, `make backup-verify`, scripts/restore.sh).
# Generated by `make env`. Keep a copy OUTSIDE the machine that stores the
# backups (e.g. a password manager): without it the backups cannot be read.
BACKUP_PASSPHRASE=
