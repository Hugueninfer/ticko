# Ticko local environment. `make env` copies this file to .env and fills in
# every value marked "generated" with random secrets. Never commit .env.

APP_NAME=Ticko
APP_ENV=local
# Generated
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Postgres. The app connects with a non-superuser role without BYPASSRLS.
DB_DATABASE=ticko
DB_USERNAME=ticko_app
# Generated
DB_PASSWORD=
POSTGRES_SUPERUSER=postgres
# Generated (only used to initialise the database)
POSTGRES_SUPERUSER_PASSWORD=

REDIS_CLIENT=phpredis
# Generated
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Set to true behind HTTPS
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# First-party SPA origins allowed to use cookie authentication. The SPA is
# served from the API's origin (the Vite dev server proxies to it), so there is
# no credentialed CORS; do not add other origins here.
SANCTUM_STATEFUL_DOMAINS=localhost:8080
SANCTUM_TOKEN_PREFIX=ticko_

HASH_DRIVER=argon2id

# Ticko settings (see apps/api/config/ticko.php)
TICKO_DOCS_ENABLED=true
TICKO_HORIZON_ADMINS=

# Host binding for the web server (keep 127.0.0.1 in development).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# AI provider keys (later phases) go ONLY in your local .env, never here.
