# Copy to apps/mobile/.env (git-ignored). Values here are compiled into the
# app and are public: never put a secret in an EXPO_PUBLIC_* variable.

# Where the phone reaches the API: your computer's LAN address and WEB_PORT
# (e.g. http://192.168.0.165:8090), or an HTTPS tunnel URL. Plain HTTP is only
# accepted in development and only for private network addresses.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Tenant (company) slug the app signs in to.
EXPO_PUBLIC_TENANT=acme

# Optional: EAS project id, needed for push notifications in a development build.
EAS_PROJECT_ID=
