{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ticko/api",
    "type": "project",
    "description": "Ticko helpdesk API",
    "keywords": [
        "helpdesk",
        "api"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "intervention/image": "^4.3",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.11",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest --coverage --min=80 --coverage-clover=build/coverage/clover.xml"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "stan": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress"
        ],
        "docs": [
            "@putenv DB_DATABASE=ticko_testing",
            "@php artisan migrate:fresh --force --no-interaction",
            "@php artisan scribe:generate --no-interaction --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
