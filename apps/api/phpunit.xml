<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <!-- Development tooling: only runs during `composer docs`. -->
            <file>app/Providers/ApiDocsServiceProvider.php</file>
        </exclude>
    </source>
    <php>
        <!-- Each forced value is set as both env and server variable, so it wins over
             values injected by docker compose (Laravel reads $_SERVER first). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:dGVzdGluZy1rZXktbm90LWEtc2VjcmV0LTAwMDAwMDA=" force="true"/>
        <server name="APP_KEY" value="base64:dGVzdGluZy1rZXktbm90LWEtc2VjcmV0LTAwMDAwMDA=" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="HASH_DRIVER" value="argon2id" force="true"/>
        <server name="HASH_DRIVER" value="argon2id" force="true"/>
        <env name="ARGON_MEMORY" value="1024" force="true"/>
        <server name="ARGON_MEMORY" value="1024" force="true"/>
        <env name="ARGON_TIME" value="1" force="true"/>
        <server name="ARGON_TIME" value="1" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="ticko_testing" force="true"/>
        <server name="DB_DATABASE" value="ticko_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="spa.test" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="spa.test" force="true"/>
        <env name="TICKO_DOCS_ENABLED" value="true" force="true"/>
        <!-- Tests never call real services, whatever the developer's .env says. -->
        <env name="TICKO_AI_TEXT_PROVIDER" value="fake" force="true"/>
        <server name="TICKO_AI_TEXT_PROVIDER" value="fake" force="true"/>
        <env name="TICKO_AI_EMBEDDING_PROVIDER" value="fake" force="true"/>
        <server name="TICKO_AI_EMBEDDING_PROVIDER" value="fake" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <server name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <server name="GROQ_API_KEY" value="" force="true"/>
        <env name="CLASSIFIER_URL" value="" force="true"/>
        <server name="CLASSIFIER_URL" value="" force="true"/>
        <env name="TICKO_TELEMETRY" value="false" force="true"/>
        <server name="TICKO_TELEMETRY" value="false" force="true"/>
        <env name="GEMINI_TEXT_MODEL" value="gemini-3.7-flash" force="true"/>
        <server name="GEMINI_TEXT_MODEL" value="gemini-3.7-flash" force="true"/>
        <env name="GEMINI_EMBEDDING_MODEL" value="gemini-embedding-001" force="true"/>
        <server name="GEMINI_EMBEDDING_MODEL" value="gemini-embedding-001" force="true"/>
        <env name="GROQ_TEXT_MODEL" value="llama-3.3-70b-versatile" force="true"/>
        <server name="GROQ_TEXT_MODEL" value="llama-3.3-70b-versatile" force="true"/>
        <env name="OLLAMA_TEXT_MODEL" value="llama3.1:8b" force="true"/>
        <server name="OLLAMA_TEXT_MODEL" value="llama3.1:8b" force="true"/>
        <env name="OLLAMA_EMBEDDING_MODEL" value="nomic-embed-text" force="true"/>
        <server name="OLLAMA_EMBEDDING_MODEL" value="nomic-embed-text" force="true"/>
        <server name="TICKO_DOCS_ENABLED" value="true" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
